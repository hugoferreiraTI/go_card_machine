      "boundElements": null,
      "updated": 1790861497335,
      "created": 1790861274506,
      "link": null,
      "locked": false,
      "text": "The terminal generates  QRcode\nThe customer's phone\n scans the QR Code, \nwhich contains a URL \n(without any hardcoded amount).\nThe customer's bank makes an \nHTTP request to that URL to \nsecurely retrieve the payment \ndetails (amount, payee, status) \nin JSON.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The terminal generates  QRcode\nThe customer's phone\n scans the QR Code, \nwhich contains a URL \n(without any hardcoded amount).\nThe customer's bank makes an \nHTTP request to that URL to \nsecurely retrieve the payment \ndetails (amount, payee, status) \nin JSON.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
